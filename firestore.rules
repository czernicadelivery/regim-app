rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. PRYWATNE DANE — tylko właściciel
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. PUBLICZNY PROFIL — świadome udostępnienie (domyślnie shareProfile: false)
    match /users/{userId}/public/{docId} {
      allow get: if request.auth != null && (
        request.auth.uid == userId
        || (docId == 'main' && resource.data.shareProfile == true)
        || exists(/databases/$(database)/documents/friendships/$(request.auth.uid + '_' + userId))
        || exists(/databases/$(database)/documents/friendships/$(userId + '_' + request.auth.uid))
      );
      allow list: if false;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. ZAPROSZENIA — wysoka entropia, get (nie list), wygaśnięcie 7 dni
    match /invites/{token} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(7, "d")
        && request.resource.data.keys().hasOnly(['createdBy', 'createdByName', 'createdAt', 'expiresAt']);
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
      allow update: if false;
    }

    // 4. PROŚBY O ZNAJOMOŚĆ — walidacja pól + tylko pending → accepted/rejected
    match /friend_requests/{requestId} {
      allow get, list: if request.auth != null 
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromUid != request.resource.data.toUid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'fromName', 'status', 'createdAt', 'inviteToken']);
      allow update: if request.auth != null
        && request.auth.uid == resource.data.toUid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
    }

    // 5. ZNAJOMOŚCI — wymaga zaakceptowanej prośby (weryfikacja przez get())
    match /friendships/{friendshipId} {
      allow get, list: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users.size() == 2
        && request.resource.data.requestId is string
        && get(/databases/$(database)/documents/friend_requests/$(request.resource.data.requestId)).data.status == 'accepted';
      allow delete: if request.auth != null && request.auth.uid in resource.data.users;
    }

    // 6. RESZTA — zamknięta
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
